# ---------------------------------------------------------------------------
# HOWLOW — example environment.
#
#   cp .env.example .env
#
# Every value below is a PLACEHOLDER. Never commit a real secret to this
# repository; .env is git-ignored for that reason. Generate the secrets with:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
SERVICE_NAME=howlow-api
APP_VERSION=0.1.0
PORT=4000
HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173

# --- PostgreSQL (financial truth) ------------------------------------------
DATABASE_URL=postgresql://howlow:howlow@localhost:5432/howlow
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_SSL=false

# --- Redis (cache, rate limiting, queues — never financial truth) ----------
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# Replace both with locally generated random values of at least 32 characters.
JWT_SECRET=generate-a-48-byte-random-value-before-running
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
SESSION_SECRET=generate-another-48-byte-random-value-here

# --- Telegram channel ------------------------------------------------------
# Leave disabled until Phase 8. When enabling, both values below are required.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Object storage (MinIO in development) ---------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=howlow-dev
S3_ACCESS_KEY=howlow-local-access-key
S3_SECRET_KEY=howlow-local-secret-key
S3_FORCE_PATH_STYLE=true

# --- Mail (Mailhog in development) -----------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=HOWLOW <no-reply@howlow.local>

# --- Web client (Vite) -----------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:4000
