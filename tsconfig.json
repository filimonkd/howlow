{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true
  },
  "include": [
    "vitest.config.ts",
    "vitest.db.config.ts",
    "eslint.config.js",
    "scripts/**/*.mjs",
    "tests/**/*.ts",
    "seeds/**/*.ts"
  ]
}
