    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@howlow/api": "*",
    "@howlow/shared": "*",
    "bullmq": "^5.81.4",
    "dotenv": "^17.4.2",
    "ioredis": "^5.11.1",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "pino-pretty": "^13.1.3"
  }
}
